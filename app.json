              "nl": "Bron-app-ID"
            }
          },
          {
            "name": "device",
            "type": "string",
            "title": {
              "en": "Monitored source",
              "nl": "Bewaakte bron"
            }
          },
          {
            "name": "device_id",
            "type": "string",
            "title": {
              "en": "Device ID",
              "nl": "Apparaat-ID"
            }
          },
          {
            "name": "zone",
            "type": "string",
            "title": {
              "en": "Zone",
              "nl": "Zone"
            }
          },
          {
            "name": "capability",
