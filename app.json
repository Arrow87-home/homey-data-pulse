              "nl": "Laatste bevestigde update"
            }
          },
          {
            "name": "affected_devices",
            "type": "string",
            "title": {
              "en": "Affected sources",
              "nl": "Getroffen bronnen"
            }
          },
          {
            "name": "stale_since",
