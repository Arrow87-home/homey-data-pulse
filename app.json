          "en": "Start test heartbeat"
        },
        "hint": {
          "en": "Local Data Watchdog simulation only. Requires the optional test source device."
        }
      },
      {
        "id": "stop_test_heartbeat",
        "title": {
          "en": "Stop test heartbeat"
        },
        "hint": {
          "en": "Local Data Watchdog simulation only. Requires the optional test source device."
        }
      },
      {
        "id": "send_test_heartbeat",
        "title": {
          "en": "Send test heartbeat now"
        },
        "hint": {
          "en": "Local Data Watchdog simulation only. Requires the optional test source device."
        }
      },
