          }
        ]
      },
      {
        "id": "record_heartbeat",
        "titleFormatted": {
          "en": "Record delivery for [[monitor]] at [[delivered_at]]"
        },
        "title": {
          "en": "Record a confirmed delivery"
        },
        "hint": {
          "en": "Only call after a successful source delivery. Supply its ISO timestamp, never a blind periodic timer."
        },
        "args": [
          {
            "name": "monitor",
            "type": "autocomplete",
            "title": {
              "en": "monitor"
            }
          },
          {
            "name": "delivered_at",
            "type": "text",
            "title": {
              "en": "Delivery timestamp (ISO with timezone)"
            }
          }
        ]
      }
    ]
